# Origen publico de la API (sin /api/v1). Vite lo incluye en el JavaScript del
# navegador: es una URL publica, nunca una clave, token ni otro secreto.
# En desarrollo y con el rewrite de Vercel se puede dejar vacio.
VITE_API_BASE_URL=
# Destino del proxy local de desarrollo. No se usa en produccion.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
# Servidor de teselas del mapa. Por defecto OpenStreetMap, que no exige API key.
# Si prefiere otro proveedor, ponga aqui su plantilla de URL con su clave.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; Colaboradores de OpenStreetMap
