# =============================================================================
# Control de Asistencia - Configuracion del backend
# -----------------------------------------------------------------------------
# Copie este archivo a `.env` y complete los valores.
# NINGUNO de estos valores debe subirse al repositorio ni incluirse en el APK.
# =============================================================================

# --- Entorno -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=Control de Asistencia
APP_TIMEZONE=America/Lima
# En produccion DEBE ser https://
PUBLIC_BASE_URL=http://localhost:4000
# Origen del panel web (CORS). Acepta varios separados por coma.
WEB_ADMIN_ORIGIN=http://localhost:5173
# Active solo si el servicio corre detras de un proxy inverso (nginx, Caddy).
TRUST_PROXY=false

# --- Base de datos -----------------------------------------------------------
DATABASE_URL=postgresql://asistencia:asistencia@localhost:5432/asistencia?schema=public

# --- Autenticacion -----------------------------------------------------------
# OBLIGATORIO CAMBIAR. Genere uno con:  openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ISSUER=asistencia-api
JWT_AUDIENCE=asistencia-clients
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Reglas de marcacion -----------------------------------------------------
# Minutos que se permite marcar ANTES de la hora programada.
CHECKIN_EARLY_WINDOW_MINUTES=15
# Precision GPS maxima aceptada, en metros. Con geocerca de 50 m, 35 es el techo
# razonable: por encima, "estar dentro" deja de ser verificable.
GPS_MAX_ACCURACY_METERS=35
# Antiguedad maxima de la lectura GPS, en segundos.
GPS_MAX_AGE_SECONDS=60
# Radio por defecto de una sede nueva, en metros.
DEFAULT_SITE_RADIUS_METERS=50
# Desfase de reloj del telefono tolerado antes de levantar un evento.
MAX_DEVICE_CLOCK_SKEW_SECONDS=300
# Hora local de cierre de jornada: se calculan faltas y salidas pendientes.
DAY_CLOSE_LOCAL_TIME=23:30

# --- Evidencias fotograficas -------------------------------------------------
# Carpeta PRIVADA del servidor. No debe estar publicada por el servidor web.
STORAGE_ROOT=./storage
EVIDENCE_MAX_BYTES=5242880
EVIDENCE_ALLOWED_MIME=image/jpeg,image/png,image/webp
EVIDENCE_URL_TTL_MINUTES=10
# Meses que la informacion permanece operativa antes de archivarse.
RETENTION_MONTHS=6

# =============================================================================
# INTEGRACIONES EXTERNAS - completar con las credenciales del propietario.
# Sin estos valores el sistema funciona igual; solo quedan inactivas las
# funciones indicadas en cada bloque.
# =============================================================================

# --- Google Drive (archivado historico) --------------------------------------
# Si esta en false, el archivado se genera y verifica en disco local y queda
# marcado como pendiente de subida. Nada se borra sin verificacion previa.
#
# Como obtener estas credenciales:
#  1. console.cloud.google.com -> crear proyecto.
#  2. Habilitar "Google Drive API".
#  3. Crear una cuenta de servicio y descargar su clave JSON.
#  4. Copiar client_email y private_key del JSON a las variables de abajo.
#  5. En Google Drive, compartir la carpeta destino con ese client_email
#     dandole permiso de Editor.
#  6. Copiar el ID de la carpeta desde su URL:
#     https://drive.google.com/drive/folders/<ESTE_ES_EL_ID>
GOOGLE_DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Pegue la clave completa en una sola linea, con los saltos como \n literales.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Solo si usa una unidad compartida de Google Workspace.
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# --- Notificaciones push (Firebase Cloud Messaging) --------------------------
# Si esta en false, las notificaciones siguen llegando dentro de la aplicacion
# y del panel (canal interno y tiempo real), pero no como aviso del sistema.
#
# Como obtener estas credenciales:
#  1. console.firebase.google.com -> crear proyecto.
#  2. Configuracion del proyecto -> Cuentas de servicio -> Generar nueva clave.
#  3. Copiar project_id, client_email y private_key del JSON descargado.
#  4. Descargar google-services.json y colocarlo en
#     mobile/android/app/google-services.json
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Correo (alertas criticas) -----------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ejemplo.com
# Destinatarios adicionales de alertas criticas, separados por coma.
ALERT_EMAIL_RECIPIENTS=

# --- Operacion ---------------------------------------------------------------
# Tareas programadas: cierre de jornada, archivado, limpieza de sesiones.
ENABLE_CRON=true
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX_REQUESTS=300
LOGIN_RATE_LIMIT_MAX=10
MARK_RATE_LIMIT_MAX=20
PRIVACY_POLICY_VERSION=1.0

# --- Administrador inicial (solo lo usa `npm run seed`) ----------------------
SEED_ADMIN_DNI=00000000
SEED_ADMIN_NAME=Administrador General
SEED_ADMIN_EMAIL=
# Si se deja vacio, el seed genera una contrasena aleatoria y la imprime UNA vez.
SEED_ADMIN_PASSWORD=
